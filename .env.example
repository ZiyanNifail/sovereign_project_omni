# SOVEREIGN OS — Environment Variables
# Copy this file to .env and fill in your keys.
# Get a free Groq key at: https://console.groq.com  (required — fast + free)
# Get a free Gemini key at: https://aistudio.google.com  (optional fallback)

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ── Optional fallback ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=

# ── User ──────────────────────────────────────────────────────────────────────
SOVEREIGN_USER_NAME=YourName
SOVEREIGN_DATA_DIR=./data
LOG_LEVEL=INFO

# ── LMS (optional — Moodle-compatible) ───────────────────────────────────────
LMS_URL=https://your-lms-url.com
LMS_USERNAME=
LMS_PASSWORD=
